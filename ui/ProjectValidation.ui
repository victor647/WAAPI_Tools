<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ProjectValidation</class>
 <widget class="QDialog" name="ProjectValidation">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1010</width>
    <height>714</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>工程规范检查</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_5">
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_2">
     <item>
     <widget class="QGroupBox" name="grpProjectStandards">
      <property name="toolTip">
       <string>命名/颜色等工程规范检查；勾选或取消勾选可整组启用/停用。</string>
      </property>
       <property name="enabled">
        <bool>true</bool>
       </property>
       <property name="font">
        <font>
         <italic>false</italic>
         <bold>false</bold>
        </font>
       </property>
       <property name="title">
        <string>工程规范</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_2">
        <item>
         <widget class="QCheckBox" name="cbxWrongCase">
          <property name="toolTip">
           <string>检查对象名是否符合设置-命名与颜色规范里选择的大小写方式（首字母大写/全小写/全大写）。</string>
          </property>
          <property name="text">
           <string>不符合大小写规范</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="autoRepeat">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxWrongNameLength">
          <property name="toolTip">
           <string>检查名称长度是否超出工程约定的范围。</string>
          </property>
          <property name="text">
           <string>名称长短不符合规范</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxColorTypeMismatch">
          <property name="toolTip">
           <string>检查对象颜色是否与分类颜色规范（设置-命名与颜色规范-颜色映射表）一致。</string>
          </property>
          <property name="text">
           <string>颜色与对象的类别不一致</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxNoRefNotesOrColorTag">
          <property name="toolTip">
           <string>检查被 Event 引用的对象备注/颜色标记是否缺失或写错（如 “Played by Event [...]”）。依赖设置里「Event 引用使用深色」与「Event 与播放对象互为备注」：只检查已开启的那部分，两者都关闭时本项不可用。</string>
          </property>
          <property name="text">
           <string>引用备注/颜色标记缺失或错误</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
     <widget class="QGroupBox" name="grpDesignStructure">
      <property name="toolTip">
       <string>层级与容器结构合理性检查；勾选或取消勾选可整组启用/停用。</string>
      </property>
       <property name="title">
        <string>设计缺陷</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_4">
        <item>
         <widget class="QCheckBox" name="cbxNestedWorkUnit">
          <property name="toolTip">
           <string>检查 WorkUnit 下是否又嵌套了 WorkUnit（多余层级）。</string>
          </property>
          <property name="text">
           <string>WorkUnit多层嵌套</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="autoRepeat">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxRedundantActorMixer">
          <property name="toolTip">
           <string>检查 ActorMixer 是否没有实际调整（音量/总线等），属于可精简的多余层级。</string>
          </property>
          <property name="text">
           <string>ActorMixer无实际调整</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSingleChildContainer">
          <property name="toolTip">
           <string>检查容器是否只包含一个子节点（可考虑打散容器）。</string>
          </property>
          <property name="text">
           <string>Container仅包含一个子节点</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxEmptyNode">
          <property name="toolTip">
           <string>检查对象是否不包含有效内容（无子级、无音频源等）。</string>
          </property>
          <property name="text">
           <string>对象不包含有效内容</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxDuplicatedParameter">
          <property name="toolTip">
           <string>检查同一对象上是否有重复绑定同一属性的 RTPC 曲线。</string>
          </property>
          <property name="text">
           <string>RTPC重复绑定内部属性</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
     <widget class="QGroupBox" name="grpSoundLocalization">
      <property name="toolTip">
       <string>源文件与本地化相关检查；勾选或取消勾选可整组启用/停用。</string>
      </property>
       <property name="title">
        <string>样本与本地化</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_3">
        <item>
         <widget class="QCheckBox" name="cbxSourceNameDifferent">
          <property name="toolTip">
           <string>检查源文件（wav）文件名与对应 Sound 命名是否不一致。</string>
          </property>
          <property name="text">
           <string>源文件与Sound命名不一致</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSourceNotImported">
          <property name="toolTip">
           <string>检查语音是否缺少参考语言或未接入语言的音频源（未接入语言见设置-工具行为）。</string>
          </property>
          <property name="text">
           <string>未导入或缺失语言</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSilentPlaceholder">
          <property name="toolTip">
           <string>检查是否使用了静音/静音插件作为临时占位资源，尚未替换为真实样本。</string>
          </property>
          <property name="text">
           <string>使用静音临时替代资源</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSoundNotInEvent">
          <property name="toolTip">
           <string>检查 Sound 是否未被任何 Event 引用（无法被播放）。</string>
          </property>
          <property name="text">
           <string>音效未被事件包含</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxInvalidTrimRange">
          <property name="toolTip">
           <string>检查 Source Editor 的裁剪起点/终点是否超出音频采样范围。</string>
          </property>
          <property name="text">
           <string>音频裁剪超出范围</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
     <widget class="QGroupBox" name="grpEventBank">
      <property name="toolTip">
       <string>Event 与 SoundBank 相关检查；勾选或取消勾选可整组启用/停用。</string>
      </property>
       <property name="title">
        <string>Event与Bank</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout">
        <item>
         <widget class="QCheckBox" name="cbxEventDuplicatedByNetRole">
          <property name="toolTip">
           <string>检查同一声源是否同时存在 1P/3P 两个 Event（应合并为 NetRole 切换）。</string>
          </property>
          <property name="text">
           <string>存在1P/3P两个事件</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxWrongEventName">
          <property name="toolTip">
           <string>检查 Event 名称是否与播放对象命名规则冲突或不规范。</string>
          </property>
          <property name="text">
           <string>Event与播放对象命名冲突</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxEmptyEvent">
          <property name="toolTip">
           <string>检查 Event 是否缺少动作（Action）或目标为空。</string>
          </property>
          <property name="text">
           <string>Event缺少动作或目标</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxEventNotInBank">
          <property name="toolTip">
           <string>检查 Event 是否未被任何 SoundBank 包含。</string>
          </property>
          <property name="text">
           <string>Event未被任何Bank包含</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxAbnormalBankSize">
          <property name="toolTip">
           <string>检查 SoundBank 体积是否异常（过大或过小）。</string>
          </property>
          <property name="text">
           <string>Bank过大或过小</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
     <widget class="QGroupBox" name="grpMistakes">
      <property name="toolTip">
       <string>其它易遗漏问题（Bus/SwitchContainer/衰减/Streaming 等）；勾选或取消勾选可整组启用/停用。</string>
      </property>
       <property name="title">
        <string>粗心大意</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_6">
        <item>
         <widget class="QCheckBox" name="cbxUnassignedToBus">
          <property name="toolTip">
           <string>检查对象是否未指定对应类别的 Output Bus。</string>
          </property>
          <property name="text">
           <string>未指定对应类别的Bus</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxUnassignedSwitchContainer">
          <property name="toolTip">
           <string>检查 SwitchContainer 是否未设置 SwitchGroup 或存在未分配的子对象。</string>
          </property>
          <property name="text">
           <string>SwitchContainer未分配</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSwitchTo1PByDefault">
          <property name="toolTip">
           <string>检查 SwitchContainer 的默认分支是否指向 1P（通常应为 3P 或全部）。</string>
          </property>
          <property name="text">
           <string>SwitchContainer默认播放1P</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxMissingAttenuation">
          <property name="toolTip">
           <string>检查 3D 音效是否未设置衰减曲线（Attenuation）。</string>
          </property>
          <property name="text">
           <string>3D音效未设置衰减曲线</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbxSoundNotStreamed">
          <property name="toolTip">
           <string>检查音乐/环境/语音等长音频是否未开启 Streaming。</string>
          </property>
          <property name="text">
           <string>音乐环境语音未Streaming</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <widget class="QPushButton" name="btnSelectAll">
       <property name="text">
        <string>全选</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnDeselectAll">
       <property name="text">
        <string>全不选</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnSaveChecks">
       <property name="text">
        <string>保存检查项</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnValidateEntireProject">
       <property name="text">
        <string>检查整个工程（可能会很慢）</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnValidateListEntries">
       <property name="text">
        <string>检查主窗口列表对象</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnValidateProjectSelection">
       <property name="text">
        <string>检查Wwise工程选中对象</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnSendResultToMainWindow">
       <property name="text">
        <string>将列表选中项发送到主窗口</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnAutoFixSelection">
       <property name="text">
        <string>一键修复列表选中项</string>
       </property>
      </widget>
     </item>
    </layout>
